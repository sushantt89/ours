{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "${headline}", "wrap": true, "weight": "Bolder", "size": "Medium", "horizontalAlignment": "Center" },
    { "type": "TextBlock", "text": "${value}", "size": "ExtraLarge", "weight": "Bolder", "horizontalAlignment": "Center", "spacing": "Small" },
    { "type": "TextBlock", "text": "${caption}", "isSubtle": true, "horizontalAlignment": "Center", "spacing": "None" }
  ],
  "actions": [{ "type": "Action.Execute", "title": "Open Ours", "verb": "open" }]
}

# Only needed when the API is hosted on a different domain from the web app.
# Leave both empty when the server serves the web app, or when using the dev proxy.

# Where realtime (WebSocket) connections go, e.g. https://ours-api.onrender.com
VITE_SOCKET_URL=

# Dev only: where the Vite dev server proxies /api and /socket.io
VITE_DEV_API=http://localhost:4000

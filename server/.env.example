# ── Core ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Public URL of the web app (used in emails, invite links, OAuth redirects, CORS)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used for the Google Drive OAuth callback)
SERVER_URL=http://localhost:4000

# MongoDB connection string. Free tier: https://www.mongodb.com/atlas
# Leave empty in development to use a throwaway in-memory database.
MONGODB_URI=

# ── Secrets (generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# 32-byte key (64 hex chars) used to encrypt Google refresh tokens at rest
ENCRYPTION_KEY=

# Cookies: "lax" when web + API share a site (recommended), "none" for cross-site
COOKIE_SAMESITE=lax

# Require a verified email before signing in (true/false)
REQUIRE_EMAIL_VERIFICATION=false

# ── Email (optional). Without SMTP, links are printed to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Ours <no-reply@example.com>"

# ── Google (optional). One OAuth client covers Sign-In and Drive.
# https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Web push (optional). Generate with: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── GIFs (optional). Free key: https://developers.giphy.com
GIPHY_API_KEY=

# ── Uploads
MAX_UPLOAD_MB=25

# ── Calls (optional relay). Without a relay, calls still work on most home Wi-Fi.
# Free option: sign up at https://www.metered.ca/stun-turn and copy your app's domain and API key.
METERED_DOMAIN=
METERED_API_KEY=
# Or any other TURN server (comma-separated URLs):
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# Set to "off" to stop looking up memory places on OpenStreetMap
GEOCODING=
